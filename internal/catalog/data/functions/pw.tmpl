# Open a configured editor workspace
pw() {
	if [[ -z $1 ]]; then
		echo 'Workspace name required'
		return 1
	fi

	# A case statement rather than an associative array: those need bash 4,
	# and macOS ships bash 3.2. It also removes the subscript-quoting hazard
	# entirely, since there is no subscript to misread as arithmetic.
	local target=""
	case "$1" in
{{- range .Workspaces }}
		{{ .Name }}) target="{{ shpath .Path }}" ;;
{{- end }}
	esac

	if [[ -n "$target" ]]; then
		{{ .Editor }} "$target"
	elif [[ -e "{{ shpath .Paths.ProjectRoot }}/$1" ]]; then
		{{ .Editor }} "{{ shpath .Paths.ProjectRoot }}/$1"
	else
		echo 'Path or workspace does not exist'
		return 1
	fi
}
