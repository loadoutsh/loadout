# Switch between the ssh keys in the ssh-agent and their corresponding
# global username and email in git config
s() {
	if [[ -z $1 ]]; then
		# Change username and email in global config
		git config --global user.name "WessCoby"
		git config --global user.email $SSH_EMAIL_DEFAULT
		gcfg
		ssh-add -D            # Remove all ssh entries from ssh agent
		ssh-add ~/.ssh/id_rsa # Add personal ssh key
	else
		if [[ $1 == "gp" ]]; then
			# Change username and email in global config
			git config --global user.name "GP"
			git config --global user.email $SSH_EMAIL_GP
			gcfg
			ssh-add -D               # Remove all ssh entries from ssh agent
			ssh-add ~/.ssh/gp_id_rsa # Add personal ssh key
		elif [[ $1 == "ut" ]]; then
			# Change username and email in global config
			git config --global user.name "Emmanuel Sekyere"
			git config --global user.email $SSH_EMAIL_UT
			gcfg
			ssh-add -D              # Remove all ssh entries from ssh agent
			ssh-add ~/.ssh/ut_es_ed # Add personal ssh key
		elif [[ $1 == "fin" ]]; then
			# Change username and email in global config
			git config --global user.name "Emmanuel Sekyere"
			git config --global user.email $SSH_EMAIL_FIN
			gcfg
			ssh-add -D               # Remove all ssh entries from ssh agent
			ssh-add ~/.ssh/fin_es_ed # Add personal ssh key
		elif [[ $1 == "wc" ]]; then
			# Change username and email in global config
			git config --global user.name "Wess"
			git config --global user.email $SSH_EMAIL_WC
			gcfg
			ssh-add -D           # Remove all ssh entries from ssh agent
			ssh-add ~/.ssh/wc_ed # Add personal ssh key
		else
			echo 'SSH Key file does not exist!'
		fi
	fi
}
