# Simple to use SSH helper function
function msh() {
	# Default values
	local keyfile="sucasa"
	local user="root"
	local host="10.0.0.2"
	local ssh_dir="$HOME/.ssh"
	local port="22"

	# Help text
	local help_text="
Helper function for SSH connections with flag arguments
Usage: msh [-k keyfile] [-u user] [-m machine] [-p port] [-h]

Options:
	-k  SSH key filename in ~/.ssh (default: sucasa)
	-u  Username for SSH connection (default: root)
	-m  Machine hostname or IP address (default: 10.0.0.2)
			If only last octet given, prepends 10.0.0.
	-p  Port number (default: 22)
	-h  Show this help message

Examples:
	msh                      # Uses all defaults
	msh -k mykey            # Custom key, default user and machine
	msh -u ubuntu -m 5      # Custom user, connects to 10.0.0.5
	msh -k mykey -u ubuntu  # Custom key and user
	msh -k mykey -u ubuntu -m 5 -p 2222  # Custom key, user, machine, and port
	msh -h                  # Show this help message"

	# Help function
	function show_help() {
		echo "$help_text"
	}

	# Parse flags
	while getopts ":k:p:u:m:h" opt; do
		case $opt in
			k) keyfile="$OPTARG" ;;
			u) user="$OPTARG" ;;
			m) host="$OPTARG" ;;
			p) port="$OPTARG" ;;
			h)
				show_help
				return 0
				;;
			\?)
				echo "Invalid option -$OPTARG" >&2
				return 1
				;;
			:)
				echo "Option -$OPTARG requires an argument" >&2
				return 1
				;;
		esac
	done

	# Check if key file exists
	if [[ ! -f "$ssh_dir/$keyfile" ]]; then
		echo "Error: SSH key '$keyfile' not found in $ssh_dir"
		return 1
	fi

	# Process host argument
	if [[ "$host" =~ ^[0-9]+$ ]]; then
		# If only last octet provided, prepend with 10.0.0.
		host="10.0.0.$host"
	fi

	# Execute SSH command
	ssh -i "$ssh_dir/$keyfile" -p "$port" "$user@$host"
}
