# Upload to remote machine via ssh
mpush() {
	if [ -z "$1" ] || [ -z "$2" ]; then
		echo "Both machine name (api, broker, py, fr or wb) and file must be provided."
		return 1
	fi

	if ! [[ "$1" =~ ^(api|broker|py|fr|wb)$ ]]; then
		echo "Machine name must be one of: api | broker | py | fr | wb"
		return 1
	fi

	if ! [ -f "$2" ]; then
		echo "File '$2' does not exist in the current path or is a directory."
		return 1
	fi

	local remote_path=${3:-"~"}
	local file=$2
	local machine

	case "$1" in
		"api")
			machine=$API_MACHINE
			;;
		"broker")
			machine=$BROKER_MACHINE
			;;
		"py")
			machine=$PY_MACHINE
			;;
		"fr")
			machine=$STATIC_MACHINE
			;;
		"wb")
			machine=$WB_API_MACHINE
			;;
	esac

	scp -i "${SSH_KEY_FILE}" ./"${file}" "${SSH_USER}"@"${machine}":"${remote_path}"/"${file}"
}
