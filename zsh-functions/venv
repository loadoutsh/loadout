# Create a Python virtual environment
venv() {
	if [[ -z $1 ]]; then
		echo 'Please specify Python version'
		return 1
	fi

	if [[ -z $2 ]]; then
		echo 'Please provide virtual environment name'
		return 1
	fi

	local python_version=$1
	local venv_name=$2
	local venv_dir="$HOME/.venv/$venv_name"

	# Check if the specified Python version is available
	if ! command -v "python$python_version" &> /dev/null; then
		echo "Python version $python_version is not installed."
		return 1
	fi

	# Check if the virtual environment already exists
	if [ -e "$venv_dir" ]; then
		echo "Virtual environment "$venv_name" already exists"
		return 1
	fi

	# Create the directory for virtual environments if it doesn't exist
	if [ ! -e "$HOME/.venv" ]; then
		mkdir "$HOME/.venv"
	fi

	# Create the virtual environment using the specified Python version
	python$python_version -m venv "$venv_dir"
	echo "Virtual environment "$venv_name" created"
}
