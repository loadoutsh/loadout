# Open VS Code workspaces
pw() {
	# Define workspace name:path mappings.
	# Keep the keys quoted. Unquoted, shfmt reads a subscript as arithmetic and
	# rewrites a key like [a11-wb] into [a11 - wb], silently breaking lookup.
	local -A workspaces=(
		["a11"]="$HOME/Projects/svt/acme/a11/a11.code-workspace"
		["a11-wb"]="$HOME/Projects/svt/acme/wb/a11-wb.code-workspace"
		["inerds"]="$HOME/Projects/inerds/web/inerds.code-workspace"
		["snipify"]="$HOME/Projects/wt/snipify/snipify.code-workspace"
	)

	if [[ -z $1 ]]; then
		echo 'Workspace name required'
	else
		if [[ -n "${workspaces[$1]}" ]]; then
			code "${workspaces[$1]}"
		elif [[ -e "$HOME/Projects/$1" ]]; then
			code "$HOME/Projects/$1"
		else
			echo 'Path or workspace does not exist'
		fi
	fi
}
