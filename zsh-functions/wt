# Clone a Wesnetech project based on name using gh (Github CLI)
# Example:
# - `wt wesnetech' should clone `https://github.com/wesnetech/wesnetech`
# -`wt api-starter server' should clone `https://github.com/wesnetech/api-starter` into `server`
wt() {
	if [[ -z $1 ]]; then
		echo 'Please provide repo name'
	else
		if [[ -z $2 ]]; then
			gh repo clone "wesnetech/$1"
		else
			gh repo clone "wesnetech/$1" $2
		fi
	fi
}
