# List the available virtual environments
lenv() {
	local venv_dir="$HOME/.venv"

	# Check if the virtual environment directory exists
	if [[ ! -d "$venv_dir" ]]; then
		echo "Virtual environment directory does not exist: $venv_dir"
		return 1
	fi

	# Loop through each directory in the virtual environment directory
	for env_dir in "$venv_dir"/*/; do
		# Check if the directory is a Python virtual environment
		if [[ -f "$env_dir/bin/activate" ]]; then
			# Extract the virtual environment name from the directory path
			local env_name=${env_dir:t}

			# Print the virtual environment name and its full path
			echo "$env_name -> $env_dir"
		fi
	done
}
