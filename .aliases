# Config ========================================================
source ~/.bash/dotfiles/.aliases.d/config.aliases

# Git ===========================================================
source ~/.bash/dotfiles/.aliases.d/git.aliases

# Npm and Yarn commands =========================================
source ~/.bash/dotfiles/.aliases.d/npm.aliases

# Docker ========================================================
source ~/.bash/dotfiles/.aliases.d/docker.aliases

# Tmux ==========================================================
source ~/.bash/dotfiles/.aliases.d/tmux.aliases

# Frameworks ====================================================
source ~/.bash/dotfiles/.aliases.d/frameworks.aliases

# Project =======================================================
source ~/.bash/dotfiles/.aliases.d/projects.aliases

# Misc ==========================================================
source ~/.bash/dotfiles/.aliases.d/misc.aliases
