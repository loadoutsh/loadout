#!/bin/bash

#: Title:           sshp
#: Date:            Sun Aug 28 13:46:53 GMT 2022
#: Author:          WessCoby
#: Version:         1.0.0
#: Description:     Assign correct permissions for ssh keys

# Begin Scripting

if [[ -d "$HOME/.ssh" ]]; then
	chmod 700 "$HOME/.ssh"
	find "$HOME/.ssh" -type f -regex ".*rsa$" -exec chmod 600 {} \; -o -regex ".*\.pem" -exec chmod 600 {} \;
	find "$HOME/.ssh" -type f -regex ".*pub$" -exec chmod 644 {} \;
	echo "Permissions modified successfully"
else
	echo "Directory does not exist"
fi
