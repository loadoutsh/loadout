alias gpush='git push'
alias gpull='git pull'
alias dpush='git push origin development'
alias dpull='git pull origin development'
alias rnm='git branch -m main'
alias gcop='git checkout main && git pull origin main'
alias gcod='git checkout development && git pull origin development'

# Git Flow ======================================================
alias finit='git flow init'
alias ff='git flow feature'
alias fr='git flow release'
alias fh='git flow hotfix'

# Github Cli ====================================================
alias repo='gh repo'
alias gist='gh gist'
alias issue='gh issue'
alias clone='repo clone'
alias create='repo create'
alias fork='repo fork'
alias view='repo view'
