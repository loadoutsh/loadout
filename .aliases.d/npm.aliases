# NVM ===========================================================
alias 16='nvm use 16'
alias 18='nvm use 18'
alias 20='nvm use 20'
alias 22='nvm use 22'
alias 24='nvm use 24'

# NPM ===========================================================
alias n='npm'
alias ni='npm install'
alias nu='npm uninstall'
alias ns='npm start'
alias nr='npm run'
alias nb='npm run build'
alias nd='npm run dev'
# ===============================================================
alias cna='npx create-next-app'
alias cnat='npx create-next-app --example with-typescript'
# ===============================================================
alias cpa='npx create-probot-app'
alias ycpa='yarn create probot-app'

# Yarn ==========================================================
alias y='yarn'
alias ys='yarn start'
alias ya='yarn add'
alias yr='yarn remove'
alias yb='yarn build'
alias yd='yarn dev'
alias yt='yarn test'
alias yte='yarn test:e2e'
# ===============================================================
alias ycna='yarn create next-app'
alias ycnae='yarn create next-app --example'
alias ycnat='yarn create next-app --example with-typescript'

# Bun ===========================================================
alias b='bun'
alias ba='bun add'
alias bi='bun install'
alias br='bun run'
alias bs='bun start'
alias bd='bun dev'
alias bt='bun test'
alias bx='bunx'

# Opencode ======================================================
alias oc='opencode'
