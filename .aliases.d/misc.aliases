alias jquery="https code.jquery.com/jquery-3.7.0.min.js | xsel -i -b"
alias q='qotm'
alias organize='organize -s . -o .'
alias fast='speed-test'
alias nema='asciinema'
alias m='mdb'
alias untar='sudo tar -xvzf'
alias wch='which'
alias wis='whatis'
alias rds='redis-cli'
alias lh='lighthouse'
alias standup='git-standup'
alias tor='torbrowser-launcher'
alias ht='htop'
alias py='python'
alias dev="ts-node-dev --respawn --clear"
alias mip="dig +short myip.opendns.com @resolver1.opendns.com | xsel -i -b"
alias ddb='duckdb'
alias rw=railway
alias llm='~/AnythingLLMDesktop/start'

# Cloudflared ===================================================
alias cf='cloudflared'
alias cft='cloudflared tunnel'
alias cftr='cloudflared tunnel run'
alias dns='cloudflared tunnel route dns dev'

# Wireguard VPN ================================================
alias vpn-up='sudo wg-quick up ut'
alias vpn-down='sudo wg-quick down ut'
alias vup='vpn-up'
alias vdn='vpn-down'
# OpenVPN ======================================================
alias ov='openvpn3'
alias ovi='ov config-import --config /home/wc/Projects/svt/utopia/misc/openvpn/v_dev_pt_56.ovpn --name ut --tag utopia'
alias ovl='ov configs-list'
alias ovc='ov session-start -c ut'
alias ovd='ov session-manage --disconnect -c ut'

# Heroku ========================================================
alias hr='heroku'
alias hr:l='heroku logs --tail'

# Travis ========================================================
alias tr='travis'

# DB Docs =======================================================
alias db=dbdocs

# Ansible =======================================================
alias ans='ansible'
alias sans='ans --become --ask-become-pass'
alias ansp='ansible-playbook'
alias sansp='ansible-playbook --ask-become-pass'

# Infisical =====================================================
alias inf='infisical'
