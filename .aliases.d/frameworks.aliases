# Gatsby =======================================================
alias g:dev='gatsby develop'
alias g:build='gatsby build'
alias g:new='gatsby new'

# Jekyll =======================================================
alias jk='jekyll'                         # new jekyll site
alias jk:new='jekyll new'                 # new jekyll site
alias jk:serve='bundle exec jekyll serve' # serve site
alias jk:build='bundle exec jekyll build' # build site
alias jk:page='bundle exec jekyll page'   # create new page
alias jk:post='bundle exec jekyll post'   # create new post

# Exercism ======================================================
alias xsm='exercism'
alias xsm:cd='cd /home/wc/snap/exercism/5/exercism'
alias xsm:d='exercism download'
alias xsm:s='exercism submit'
alias xsm:o='exercism open'
alias xsm:v='exercism version'

# Flutter =======================================================
alias fl='flutter'
alias fl:h='flutter -h'
alias fl:v='flutter -v'
alias fl:b='flutter build'
alias fl:d='flutter doctor'
alias fl:i='flutter install'
alias fl:g='flutter generate'
alias fl:s='flutter screenshot'
alias fl:u='flutter upgrade'
