			;;
		edge-a)
			host="edge-a"
			user="root"
			key=""
			port="0"
			upload_path=""
			;;
		edge-b)
			host="edge-b"
			user="root"
			key=""
			port="0"
			upload_path=""
			;;
		api)
			host="api.example.internal"
			user="azureuser"
			key="$HOME/.ssh/deploy"
			port="0"
			upload_path=""
			;;
		broker)
			host="broker.example.internal"
			user="azureuser"
			key="$HOME/.ssh/deploy"
			port="0"
			upload_path=""
			;;
		py)
			host="py.example.internal"
			user="azureuser"
			key="$HOME/.ssh/deploy"
			port="0"
			upload_path=""
