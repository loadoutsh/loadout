# Functions ======================================================
# Activate a Python virtual environment
activate() {
	if [[ -z $1 ]]; then
		echo 'Please specify virtual environment'
		return 1
	fi

	if [[ -d "$HOME/.venv/$1" ]]; then
		source "$HOME/.venv/$1/bin/activate"
	else
		echo "Virtual environment $1 does not exist"
		return 1
	fi
}

# Clone a repository from the example-org organisation using the GitHub CLI
# Example: `clone-eg api-starter server' clones example-org/api-starter into server
clone-eg() {
	if [[ -z $1 ]]; then
		echo 'Please provide repo name'
		return 1
	fi

	if [[ -z $2 ]]; then
		gh repo clone "example-org/$1"
	else
		gh repo clone "example-org/$1" "$2"
	fi
}

# Delete a Python virtual environment
denv() {
	if [[ -z $1 ]]; then
		echo 'Please specify virtual environment'
		return 1
	fi

	if [[ -d "$HOME/.venv/$1" ]]; then
		rm -rf "$HOME/.venv/$1"
		echo "Virtual environment $1 deleted"
	else
		echo "Virtual environment $1 does not exist"
		return 1
	fi
}

# Show the git identity in effect
gcfg() {
	echo "Username: $(git config user.name) | Email: $(git config user.email)"
}

# Kill the process listening on the given port
kp() {
	if [[ -z $1 ]]; then
		echo 'Please specify port'
		return 1
	fi

	local found=0 pid
	# Command substitution in a for loop word-splits in both zsh and bash.
	# ${=pids} would have been zsh-only, and bash rejects it outright.
	for pid in $(sudo lsof -t -i:"$1" 2> /dev/null); do
		sudo kill -9 "$pid"
		found=$((found + 1))
	done

	if [[ $found -eq 0 ]]; then
		echo "Nothing is listening on port $1"
		return 1
	fi
	echo "Killed $found process(es) on port $1"
}

# List the available Python virtual environments
lenv() {
	local venv_root="$HOME/.venv"

	if [[ ! -d $venv_root ]]; then
		echo "Virtual environment directory does not exist: $venv_root"
		return 1
	fi

	local env_dir
	for env_dir in "$venv_root"/*/; do
		if [[ -f "$env_dir/bin/activate" ]]; then
			# basename rather than the zsh :t modifier, which bash ignores
			# silently and returns the full path for.
			echo "$(basename "$env_dir") -> $env_dir"
		fi
	done
}

# Upload a file to a configured remote host over scp
