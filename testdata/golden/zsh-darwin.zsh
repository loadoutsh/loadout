	npm install -g tldr @nestjs/cli pm2 serve ts-node-dev npm-check-updates degit corepack dbdocs @infisical/cli prettier
}

# Navigate to the projects directory, or any path beneath it
# Example: `p wc/qotm' goes to ~/Projects/wc/qotm
p() {
	if [[ -z $1 ]]; then
		cd "$HOME/Projects"
	else
		if [[ -e "$HOME/Projects/$1" ]]; then
			cd "$HOME/Projects/$1"
		else
			echo 'Path does not exist'
			return 1
		fi
	fi
}

# Open a project from the projects directory in the editor
# Example: `pv wc/qotm' opens ~/Projects/wc/qotm
pv() {
	if [[ -z $1 ]]; then
		echo 'Please specify a project name or path'
		return 1
	fi

	if [[ -e "$HOME/Projects/$1" ]]; then
		code "$HOME/Projects/$1"
	else
		echo 'Project name or path does not exist'
		return 1
	fi
}

# Open a configured editor workspace
pw() {
	if [[ -z $1 ]]; then
		echo 'Workspace name required'
		return 1
	fi

	# A case statement rather than an associative array: those need bash 4,
	# and macOS ships bash 3.2. It also removes the subscript-quoting hazard
	# entirely, since there is no subscript to misread as arithmetic.
	local target=""
	case "$1" in
		api) target="$HOME/Projects/api/api.code-workspace" ;;
		api-web) target="$HOME/Projects/api-web/api-web.code-workspace" ;;
		docs) target="$HOME/Projects/docs/docs.code-workspace" ;;
		tools) target="$HOME/Projects/tools/tools.code-workspace" ;;
	esac

	if [[ -n "$target" ]]; then
		code "$target"
	elif [[ -e "$HOME/Projects/$1" ]]; then
		code "$HOME/Projects/$1"
	else
		echo 'Path or workspace does not exist'
		return 1
	fi
}

# Switch the global git identity and the SSH key that goes with it
s() {
	local id="${1:-default}"

	case "$id" in
		default)
			git config --global user.name "Example User"
			git config --global user.email "default@example.com"
			ssh-add -D > /dev/null 2>&1
			ssh-add "$HOME/.ssh/id_rsa"
			;;
		gp)
			git config --global user.name "Example Two"
			git config --global user.email "gp@example.com"
			ssh-add -D > /dev/null 2>&1
			ssh-add "$HOME/.ssh/id_two"
			;;
		ut)
			git config --global user.name "Example Three"
			git config --global user.email "ut@example.com"
			ssh-add -D > /dev/null 2>&1
			ssh-add "$HOME/.ssh/id_three"
			;;
		fin)
			git config --global user.name "Example Three"
			git config --global user.email "fin@example.com"
			ssh-add -D > /dev/null 2>&1
			ssh-add "$HOME/.ssh/id_four"
			;;
		five)
			git config --global user.name "Example Four"
			git config --global user.email "five@example.com"
			ssh-add -D > /dev/null 2>&1
			ssh-add "$HOME/.ssh/id_five"
			# Swap the credential entries this identity nominates, and bring the
			# new values into this shell in the same step.
			eval "$(loadout identity activate five --export)"
			;;
		*)
			echo "Unknown identity: $id"
			echo "Known: default, gp, ut, fin, five"
			return 1
			;;
	esac

	gcfg
}

# Create a Python virtual environment
venv() {
	if [[ -z $1 ]]; then
		echo 'Please specify Python version'
		return 1
	fi

	if [[ -z $2 ]]; then
		echo 'Please provide virtual environment name'
		return 1
	fi

	local venv_dir="$HOME/.venv/$2"

	if ! command -v "python$1" > /dev/null 2>&1; then
		echo "Python version $1 is not installed."
		return 1
	fi

	if [[ -e $venv_dir ]]; then
		echo "Virtual environment $2 already exists"
		return 1
	fi

	mkdir -p "$HOME/.venv"
	"python$1" -m venv "$venv_dir"
	echo "Virtual environment $2 created"
}

