# SSH helper. Accepts a configured host alias, a bare last octet, or a hostname
msh() {
	local keyfile="box-b"
	local user="root"
	local host="10.0.0.2"
	local port="22"
	local ssh_dir="$HOME/.ssh"

	local help_text="SSH helper

Usage: msh [-k keyfile] [-u user] [-m machine] [-p port] [-h]

  -k  SSH key filename in ~/.ssh (default: $keyfile)
  -u  Username (default: $user)
  -m  Host alias, hostname, or a bare last octet (default: $host)
  -p  Port (default: $port)
  -h  Show this message

Configured host aliases: box-a, box-b, edge-a, edge-b, api, broker, py, fr, wb"

	# zsh makes OPTIND local to a function; bash does not, so without this a
	# second call to msh in the same shell silently ignores its flags.
	local opt OPTIND=1
	while getopts ":k:p:u:m:h" opt; do
		case $opt in
			k) keyfile="$OPTARG" ;;
			u) user="$OPTARG" ;;
			m) host="$OPTARG" ;;
			p) port="$OPTARG" ;;
			h)
				echo "$help_text"
				return 0
				;;
			\?)
				echo "Invalid option -$OPTARG" >&2
				return 1
				;;
			:)
				echo "Option -$OPTARG requires an argument" >&2
				return 1
				;;
		esac
	done

	# A configured alias wins over treating the value as a hostname
	case "$host" in
		box-a)
			host="box-a"
			user="root"
			port="0"
			;;
		box-b)
			host="box-b"
			user="root"
			port="0"
			;;
		edge-a)
			host="edge-a"
			user="root"
			port="0"
			;;
		edge-b)
			host="edge-b"
			user="root"
			port="0"
			;;
		api)
			host="api.example.internal"
			user="azureuser"
			port="0"
			keyfile="$(basename "$HOME/.ssh/deploy")"
			;;
		broker)
			host="broker.example.internal"
			user="azureuser"
			port="0"
			keyfile="$(basename "$HOME/.ssh/deploy")"
			;;
		py)
			host="py.example.internal"
			user="azureuser"
			port="0"
			keyfile="$(basename "$HOME/.ssh/deploy")"
			;;
		fr)
			host="static.example.internal"
			user="azureuser"
			port="0"
			keyfile="$(basename "$HOME/.ssh/deploy")"
			;;
		wb)
			host="wb.example.internal"
			user="azureuser"
			port="0"
			keyfile="$(basename "$HOME/.ssh/deploy")"
			;;
	esac

	# A bare number is treated as the last octet of 10.0.0.0
	if [[ "$host" =~ ^[0-9]+$ ]]; then
		host="10.0.0.$host"
	fi

	if [[ ! -f "$ssh_dir/$keyfile" ]]; then
		echo "Error: SSH key '$keyfile' not found in $ssh_dir"
		return 1
	fi

	ssh -i "$ssh_dir/$keyfile" -p "$port" "$user@$host"
}

